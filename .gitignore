state/reader/state/
state/lineage/
state/population/
state/merged/

# Public-domain books fetched by tools/make_library.py.
# Reproducible exactly from a URL and a script.
books/*.txt

# Live runtime state: the individual's own memory, kept on disk, never in git.
# Committing it again would snapshot a multi-MB brain on every commit.
state/language_state.json
state/language_state.json.*
state/banc_brain.npz
state/_learning_backup_*
state/house_agent_*
state/knowledge_ledger.jsonl
state/h/
state/*.log
state/*.pid
state/battery_*.txt
state/holdout_*.txt
