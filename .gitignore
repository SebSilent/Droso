exocortex/stream_progress.json
exocortex/learned_procedures.json

# Runtime artefacts: All regenerable from the corpus, the tools and the clock.
#
# state/selection/ is deliberately NOT here, unlike state/fitness/. It is the
# lineage record of the generational harness (tools/run_generation.py): one row per
# brain carrying its genome, its parent, both pass sets and the seals it was
# measured under. A lineage that only exists on one machine cannot be audited, and
# force-adding it generation by generation would leave gaps nobody notices. It costs
# ~94 KB per generation (generation_0: 12.7 KB of rows, 79.6 KB of per-ask journal,
# 1.7 KB of base genome); if that ever becomes a problem the per-ask journals are
# the part to stop tracking, not the rows.
state/sessions/
state/merged*/
state/reading/
state/shelf/
state/fitness/
state/population/
state/reader.log
state/drill_store.json

# Learner lineage: the AUDIT RECORDS are tracked and the CHECKPOINTS are not.
# git cannot re-include a file whose parent directory is excluded, so this ignores
# the contents rather than the directory. episodes.jsonl is ~9 KB per episode and an
# ask journal ~50 KB; a checkpoint is the whole language state including a 250 MB SAN,
# which is regenerable from the ledger's generator seed and seal and does not belong
# in git. state_hygiene.py caps lineage at 2 -- design section 9 flags that this must
# be raised before a third episode or a checkpoint gets deleted.
state/lineage/*
!state/lineage/episodes.jsonl
!state/lineage/episodes_precorrection*.jsonl
!state/lineage/episodes_preseal*.jsonl
!state/lineage/promotions.jsonl
!state/lineage/episode_*_asks.jsonl

# The persistent learner (tools/promote_learner.py). A checkpoint is 260 MB, 222 MB of
# it the binder's cortex.npz, and versions are hardlinked snapshots of it -- so this is
# the one area of state/ that must never be tracked. It is regenerable: bootstrap from
# the live state and replay the episode ledger, whose rows carry the generator seed and
# batch seal. The MANIFEST is small and is the audit record, so it is tracked.
state/live_learner/current/
state/live_learner/versions/
state/live_learner/staging/
!state/live_learner/manifest.json

# Consolidation rollback backups: per-run copies of the live state, kept on
# disk only (the rollback for tools/consolidate_live.py), never in git.
state/backup_pre_consolidate_*/
