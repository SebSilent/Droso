  "the_rule": {
    "address": "each id is a row of wte.weight at byte_offset = base + id*768*4, and the probe's address is the ORDERED LIST of those rows. The address of a two-token word is not a place in the file; it is a path through it.",
    "applies_to": "a curriculum word whose space-prefixed form is not a single entry of vocab.json",
    "default_option": "mean of the sub-token rows, because it is the only one that keeps the extraction's arithmetic unchanged -- and that is a reason to be suspicious of it, recorded below.",
    "derived_probe_vector_options": [
      {
        "cost": "no extra read calls; element-wise work is not an operation under either reading",
        "option": "mean of the sub-token rows",
        "what_it_is": "one 768-vector, element-wise over rows already read"
      },
      {
        "cost": "no extra reads, but the similarity is no longer a cosine between two rows of one matrix",
        "option": "the sequence itself, compared as a set of rows",
        "what_it_is": "no derived vector; the claim is about the tokens the word splits into"
      },
      {
        "cost": "one row",
        "option": "first sub-token only",
        "what_it_is": "a prefix probe, which is a different word's row",
        "why_it_is_named_here": "it is the tempting shortcut, because it makes a 17-word gap disappear with no new machinery. It is NOT this rule: '\u0120gua' is not 'guard' and a figure built on it would be about a prefix."
      }
    ],
    "encoder": "tools/mp_e12_bpe_probe_rule.py -- arithmetic over merges.txt and vocab.json. No tokenizers, no transformers, no torch, no numpy.",
    "name": "sub-token probing by byte-level BPE",
    "pre_tokenizer_scope": "the 17 words are pure ASCII letters, so the space-prefixed form is ONE pre-token under GPT-2's split pattern and no regex is needed. A word with a digit, a hyphen or an apostrophe would need the pattern itself, and this rule does not claim to cover that case: it would be a separate registration.",
    "probe_object": "a SEQUENCE of token ids, not an id. (t1, t2, ...) with t1 first."
  },
  "tokenizer_provenance": {
    "path": "experiments/MP-E12/donor/gpt2/PROVENANCE_tokenizer.json",
    "revision_pinned": "607a30d783dfa663caf39e06633721c8d4cfcd7e",
    "same_revision_as_the_weights": true,
    "vocab_bpe": "absent at this revision, HTTP 404 measured -- the merges are in merges.txt and the id table in vocab.json, so nothing here needed a second serialisation of the same fact"
  },
  "what_a_sub_token_result_can_support": [
    "that the donor's tokenizer splits this word this way, which is a property of the tokenizer and is already true before any row is read",
    "that the MEAN of these specific rows sits at this cosine distance from the mean of those specific rows",
    "that a word needing k rows occupies k rows, which is a real fact about the vocabulary and is why sub-word blending exists at all"
  ],
  "what_a_sub_token_result_cannot_support": [
    "that the word has a row in wte. It does not. A word that resolves to two tokens is not one row, and no average of two rows is the word's row -- the model never sees that vector at that address.",
    "that the sub-token rows mean the word. They mean their own pieces; '\u0120gua' + 'rd' is a spelling.",
    "a comparison against a single-token probe on equal footing. A mean of two rows has different statistics from one row: its norm shrinks as pieces disagree, so a cosine between a mean and a row is not the same measurement in two places. Any figure that mixes the two must say which is which.",
    "any behavioural claim, and no latency claim. The same R11 and R17 boundaries that bind the sealed class-1 graph bind this: no forward pass, no sampling, nothing reaching an answer path."
  ],
  "what_must_be_decided_before_this_is_used": [
    "whether a mean-of-rows probe is admissible at all, given that the model never sees that vector at that address -- this is a claim question, not a cost question",
    "whether the 17 join the battery as a separate class with its own schema field, or stay out",
    "the gather-accounting ruling, which decides what any of it costs"
  ],
  "what_this_step_did_not_do": {
    "no_extraction": true,
    "no_new_probe_authorized": true,
    "no_probe_list_v1_edit": true,
    "no_sealed_artifact_rewritten": true,
    "no_tokenizer_runtime_imported": true,
    "no_weight_byte_read": true
  },
  "why_the_17_were_deferred": "these words have no unique single-token id in the donor's vocabulary; probing them means encoding them with the donor's BPE and taking a sub-token, which is a different probe object. The BPE encoder is not implemented in this step and is a named follow-on. They are not silently dropped, and they were not selected for or against on anything seen in the weight bytes."
}
