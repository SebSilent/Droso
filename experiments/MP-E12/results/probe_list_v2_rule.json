{
  "a_finding_the_self_check_produced": {
    "fix": "the check now encodes the form v1 RECORDS instead of re-deriving a form, and the candidate-form table for the 17 is built from v1's own documented precedence rather than a second convention invented here",
    "what_happened": "the first cut of this check encoded space+lowercase and got two tokens where v1 records one id, 32561. The encoder was right and the check was wrong: v1's registered vocab_form for `nora` is the capitalised \"Nora\", which IS a single token (the merge path ('\u0120nor','a') does not exist in merges.txt, so space+lowercase is genuinely two tokens).",
    "why_it_matters": "a probe list is a set of (form, id) pairs, not of words. Two rules for choosing a form is how a hidden choice gets into a registered instrument, and this would have been found by a later reader as an unexplained disagreement between two artifacts.",
    "word": "nora"
  },
  "cost_under_both_readings": {
    "conservative_reading": {
      "operations_per_word": "2 for the probe row plus pool, as in class 1 -- the sub-token case adds ROWS, not calls",
      "read_calls_per_word": 1,
      "why_one_call": "the whole sequence fits inside MAX_ROWS_PER_READ=64 for every word here (max 3 tokens), so the rows are one bounded gather"
    },
    "honest_caveat": "the cost barely changes, which makes this rule look free. The thing that changes is the meaning of a probe, and a rule that costs nothing to adopt is exactly the kind that gets adopted without anyone reading the sentence above it.",
    "max_tokens_for_one_word": 3,
    "n_words": 17,
    "no_cap_would_need_raising": true,
    "per_row_reading": {
      "conservative_ops_if_the_17_were_added": "the 17 words would add 36 rows to a battery that already charges 1,536 of them; under the per-row reading that is the number that moves, and it is the one the ruling decides",
      "rows_added_by_the_17": 36
    },
    "registered_rule": {
      "note": "the registered rule prices gathers at zero, so sub-token probing is free. That is the loophole again, and it is why this table is not a reason to prefer the cheap reading.",
      "operations_per_word": "unchanged: one similarity search over the pool, plus the element-wise mean, which is not an operation",
      "read_calls_per_word": 1
    },
    "rows_total": 36
  },
